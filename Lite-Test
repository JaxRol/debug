local function make(ClassName, Properties, Parent)
    local Object = Instance.new(ClassName)
    for Key, Value in pairs(Properties or {}) do
        Object[Key] = Value
    end
    Object.Parent = Parent
    return Object
end

local function rounded(Object, Radius)
    return make("UICorner", { CornerRadius = UDim.new(0, Radius or 7) }, Object)
end

local function pad(Object, Left, Right, Top, Bottom)
    return make("UIPadding", {
        PaddingLeft = UDim.new(0, Left or 0),
        PaddingRight = UDim.new(0, Right or 0),
        PaddingTop = UDim.new(0, Top or 0),
        PaddingBottom = UDim.new(0, Bottom or 0)
    }, Object)
end

local function stack(Object, Gap, Direction)
    return make("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        FillDirection = Direction or Enum.FillDirection.Vertical,
        Padding = UDim.new(0, Gap or 0)
    }, Object)
end

local function paint(Object, Property, ThemeKey)
    Object[Property] = Library.Theme[ThemeKey]
    table.insert(Library.Paints, { Object = Object, Property = Property, Key = ThemeKey })
    return Object
end

local function label(Parent, Text, Size, ColorKey, Height, Bold)
    local Item = make("TextLabel", {
        BackgroundTransparency = 1,
        Text = tostring(Text or ""),
        Font = Bold and Enum.Font.GothamBold or Enum.Font.Gotham,
        TextSize = Size or 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = true,
        Size = UDim2.new(1, 0, 0, Height or 20),
        BorderSizePixel = 0
    }, Parent)
    paint(Item, "TextColor3", ColorKey or "Text")
    return Item
end

local function hook(Connection)
    table.insert(Library.Connections, Connection)
    return Connection
end

local function safeCall(Callback, ...)
    if type(Callback) == "function" then
        local Ok, Error = pcall(Callback, ...)
        if not Ok then
            warn("ZeroPoint Lite callback: " .. tostring(Error))
        end
    end
end

function Library:SetThemePreset(Name)
    if not self.Themes[Name] then
        return false
    end
    self.ThemeName = Name
    self.Theme = self.Themes[Name]
    for _, Entry in ipairs(self.Paints) do
        if Entry.Object.Parent then
            Entry.Object[Entry.Property] = self.Theme[Entry.Key]
        end
    end
    for _, Refresh in ipairs(self.Refreshers) do
        Refresh()
    end
    return true
end

function Library:Unload()
    for _, Connection in ipairs(self.Connections) do
        Connection:Disconnect()
    end
    for _, Window in ipairs(self.Windows) do
        if Window.ScreenGui then
            Window.ScreenGui:Destroy()
        end
    end
    table.clear(self.Connections)
    table.clear(self.Paints)
    table.clear(self.Refreshers)
    table.clear(self.Windows)
    table.clear(self.Toggles)
    table.clear(self.Options)
end

function Library:CreateWindow(Info)
