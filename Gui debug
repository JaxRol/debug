function Library:SafeCallback(Func: (...any) -> ...any, ...: any)
    if not (Func and typeof(Func) == "function") then
        return
    end
    local Result = table.pack(xpcall(Func, function(Error)
        task.defer(error, debug.traceback(Error, 2))
        if self.NotifyOnError then
            self:Notify({
                Title = "Error",
                Description = Error,
                Time = 10,
                Icon = "circle-x",
            })
        end
        return Error
    end, ...))
    if not Result[1] then
        return nil
    end
    return table.unpack(Result, 2, Result.n)
end
function Library:MakeDraggable(
    UI: GuiObject,
    DragFrame: GuiObject,
    IgnoreToggled: boolean?,
    IsMainWindow: boolean?,
    CanDrag: (() -> boolean)?
)
    local StartPos
    local FramePos
    local Dragging = false
    local DragDistance = 0
    local LastDragEnded = 0
    local Changed
    local DragController = {}
    local function DraggingAllowed(): boolean
        return not CanDrag or CanDrag()
    end
    DragFrame.InputBegan:Connect(function(Input: InputObject)
        if
            not IsClickInput(Input)
            or IsMainWindow and Library.CantDragForced
            or not DraggingAllowed()
        then
            return
        end
        StartPos = Input.Position
        FramePos = UI.Position
        DragDistance = 0
        Dragging = true
        Changed = Input.Changed:Connect(function()
            if Input.UserInputState ~= Enum.UserInputState.End then
                return
            end
            if DragDistance >= 6 then
                LastDragEnded = tick()
            end
            Dragging = false
            if Changed and Changed.Connected then
                Changed:Disconnect()
                Changed = nil
            end
        end)
    end)
    Library:GiveSignal(UserInputService.InputChanged:Connect(function(Input: InputObject)
        if
            (not IgnoreToggled and not Library.Toggled)
            or (IsMainWindow and Library.CantDragForced)
            or not DraggingAllowed()
            or not (ScreenGui and ScreenGui.Parent)
        then
            Dragging = false
            if Changed and Changed.Connected then
                Changed:Disconnect()
                Changed = nil
            end
            return
        end
        if Dragging and IsHoverInput(Input) then
            local Delta = Input.Position - StartPos
            DragDistance = Delta.Magnitude
            UI.Position =
                UDim2.new(FramePos.X.Scale, FramePos.X.Offset + Delta.X, FramePos.Y.Scale, FramePos.Y.Offset + Delta.Y)
        end
    end))
    function DragController:ConsumeDrag(): boolean
        if tick() - LastDragEnded <= 0.25 then
            LastDragEnded = 0
            return true
        end
        return false
    end
    return DragController
end
function Library:MakeDragScrollable(ScrollingFrame: ScrollingFrame)
    assert(ScrollingFrame and ScrollingFrame:IsA("ScrollingFrame"), "Expected a ScrollingFrame")

    if not table.find(Library.DragScrollingFrames, ScrollingFrame) then
        table.insert(Library.DragScrollingFrames, ScrollingFrame)
    end

    if Library.DragScrollingInitialized then
        return ScrollingFrame
    end

    Library.DragScrollingInitialized = true

    local ActiveScrollingFrame = nil
    local DragInput = nil
    local StartY = 0
    local StartCanvasY = 0

    local function IsEffectivelyVisible(Gui: GuiObject): boolean
        local Current = Gui

        while Current and Current ~= ScreenGui do
            if Current:IsA("GuiObject") and not Current.Visible then
                return false
            end

            Current = Current.Parent
        end

        return Current == ScreenGui
    end

    local function IsInteractiveAtPosition(Frame: ScrollingFrame, Position: Vector2): boolean
        local ScrollBarWidth = Frame.ScrollBarThickness
        local RightEdge = Frame.AbsolutePosition.X + Frame.AbsoluteSize.X

        if ScrollBarWidth > 0 and Position.X >= RightEdge - ScrollBarWidth - 2 then
            return true
        end

        for _, Gui in Frame:GetDescendants() do
            if
                Gui:IsA("GuiObject")
                and Gui.Visible
                and IsEffectivelyVisible(Gui)
                and Gui.AbsoluteSize.X > 0
                and Gui.AbsoluteSize.Y > 0
                and Library:MouseIsOverFrame(Gui, Position)
                and (Gui:IsA("GuiButton") or Gui:IsA("TextBox") or Gui.Active)
            then
                return true
            end
        end

        for _, Gui in ScreenGui:GetDescendants() do
            if
                Gui:IsA("GuiObject")
                and not Gui:IsDescendantOf(Frame)
                and not Frame:IsDescendantOf(Gui)
                and Gui.Visible
                and IsEffectivelyVisible(Gui)
                and Gui.ZIndex >= Frame.ZIndex
                and Gui.AbsoluteSize.X > 0
                and Gui.AbsoluteSize.Y > 0
                and Library:MouseIsOverFrame(Gui, Position)
                and (Gui:IsA("GuiButton") or Gui:IsA("TextBox") or Gui.Active)
            then
                return true
            end
        end

        return false
    end

    Library:GiveSignal(UserInputService.InputBegan:Connect(function(Input: InputObject)
        if
            Input.UserInputType ~= Enum.UserInputType.MouseButton1
            or not Library.IsRobloxFocused
            or not Library.Toggled
            or Library.ActiveDialog
        then
            return
        end

        for _, Frame in Library.DragScrollingFrames do
            if
                Frame.Parent
                and Frame.ScrollingEnabled
                and IsEffectivelyVisible(Frame)
                and Library:MouseIsOverFrame(Frame, Input.Position)
                and not IsInteractiveAtPosition(Frame, Input.Position)
            then
                local MaximumCanvasY = math.max(0, Frame.AbsoluteCanvasSize.Y - Frame.AbsoluteWindowSize.Y)

                if MaximumCanvasY <= 0 then
                    return
                end

                ActiveScrollingFrame = Frame
                DragInput = Input
                StartY = Input.Position.Y
                StartCanvasY = Frame.CanvasPosition.Y
                return
            end
        end
    end))

    Library:GiveSignal(UserInputService.InputChanged:Connect(function(Input: InputObject)
        if
            not ActiveScrollingFrame
            or not DragInput
            or Input.UserInputType ~= Enum.UserInputType.MouseMovement
        then
            return
        end

        if
            not ActiveScrollingFrame.Parent
            or not ActiveScrollingFrame.ScrollingEnabled
            or not IsEffectivelyVisible(ActiveScrollingFrame)
        then
            ActiveScrollingFrame = nil
            DragInput = nil
            return
        end

        local MaximumCanvasY = math.max(
            0,
            ActiveScrollingFrame.AbsoluteCanvasSize.Y - ActiveScrollingFrame.AbsoluteWindowSize.Y
        )
        local DragDelta = Input.Position.Y - StartY

        ActiveScrollingFrame.CanvasPosition = Vector2.new(
            ActiveScrollingFrame.CanvasPosition.X,
            math.clamp(StartCanvasY - DragDelta, 0, MaximumCanvasY)
        )
    end))

    Library:GiveSignal(UserInputService.InputEnded:Connect(function(Input: InputObject)
        if not DragInput or Input.UserInputType ~= Enum.UserInputType.MouseButton1 then
            return
        end

        ActiveScrollingFrame = nil
        DragInput = nil
    end))

    return ScrollingFrame
end
