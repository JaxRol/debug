    local function EncodeWatermarkPosition(Position: UDim2): string
        return string.format(
            "%.6f,%.3f,%.6f,%.3f",
            Position.X.Scale,
            Position.X.Offset,
            Position.Y.Scale,
            Position.Y.Offset
        )
    end

    local function DecodeWatermarkPosition(Value): UDim2?
        if typeof(Value) == "UDim2" then
            return Value
        end

        if typeof(Value) ~= "string" then
            return nil
        end

        local XScale, XOffset, YScale, YOffset = Value:match(
            "^%s*([%+%-]?[%d%.eE]+)%s*,%s*([%+%-]?[%d%.eE]+)%s*,%s*([%+%-]?[%d%.eE]+)%s*,%s*([%+%-]?[%d%.eE]+)%s*$"
        )

        XScale = tonumber(XScale)
        XOffset = tonumber(XOffset)
        YScale = tonumber(YScale)
        YOffset = tonumber(YOffset)

        if not XScale or not XOffset or not YScale or not YOffset then
            return nil
        end

        return UDim2.new(XScale, XOffset, YScale, YOffset)
    end

    local WatermarkPositionOption = {
        Type = "Input",
        Value = EncodeWatermarkPosition(_WMDefaultPosition),
        Default = EncodeWatermarkPosition(_WMDefaultPosition),
    }

