local function UpdateTarget(Target, DeltaTime)
    if not Target.Enabled or not Target.Layer or not Target.Layer.Visible then
        return
    end
    RefreshTargetParticleCount(Target)
    local Speed = Target.Speed
    for Index = 1, #Target.Particles do
        local Particle = Target.Particles[Index]
        local Object = Particle.Object
        local Effect = Particle.Effect
        Particle.Age += DeltaTime * Speed
        Particle.Phase += DeltaTime * Speed
        if Effect == "Snow" then
            Particle.X += (Particle.VX + math.sin(Particle.Phase * 1.6) * 0.012) * DeltaTime * Speed
            Particle.Y += Particle.VY * DeltaTime * Speed
            Particle.Spin += Particle.SpinSpeed * DeltaTime * Speed
            Object.Rotation = Particle.Spin
        elseif Effect == "Rain" then
            Particle.X += Particle.VX * DeltaTime * Speed
            Particle.Y += Particle.VY * DeltaTime * Speed
        elseif Effect == "Stars" then
            Particle.X += Particle.VX * DeltaTime * Speed
            Particle.Y += Particle.VY * DeltaTime * Speed
            Object.BackgroundTransparency = math.clamp(Particle.BaseTransparency + math.sin(Particle.Phase * 3.2) * 0.28, 0.02, 0.88)
        elseif Effect == "Fireflies" then
            Particle.X += (Particle.VX + math.sin(Particle.Phase * 1.8) * 0.018) * DeltaTime * Speed
            Particle.Y += (Particle.VY + math.cos(Particle.Phase * 1.35) * 0.012) * DeltaTime * Speed
            Object.BackgroundTransparency = math.clamp(0.34 + math.sin(Particle.Phase * 4) * 0.28, 0.04, 0.78)
        elseif Effect == "Embers" then
            Particle.X += (Particle.VX + math.sin(Particle.Phase * 2.2) * 0.014) * DeltaTime * Speed
            Particle.Y += Particle.VY * DeltaTime * Speed
            Object.BackgroundTransparency = math.clamp(0.22 + math.sin(Particle.Phase * 7) * 0.18, 0.02, 0.72)
        elseif Effect == "Bubbles" then
            Particle.X += (Particle.VX + math.sin(Particle.Phase * 1.7) * 0.012) * DeltaTime * Speed
            Particle.Y += Particle.VY * DeltaTime * Speed
        elseif Effect == "Matrix" then
            Particle.Y += Particle.VY * DeltaTime * Speed
            Particle.CharacterElapsed += DeltaTime * Speed
            if Particle.CharacterElapsed >= 0.12 then
                Particle.CharacterElapsed = 0
                Object.Text = GetRandomArrayValue(MatrixCharacters)
            end
        elseif Effect == "Confetti" then
            Particle.X += (Particle.VX + math.sin(Particle.Phase * 2.5) * 0.018) * DeltaTime * Speed
            Particle.Y += Particle.VY * DeltaTime * Speed
            Particle.Spin += Particle.SpinSpeed * DeltaTime * Speed
            Object.Rotation = Particle.Spin
        end
        Object.Position = UDim2.fromScale(Particle.X, Particle.Y)
        if Particle.X < -0.12
            or Particle.X > 1.12
            or Particle.Y < -0.15
            or Particle.Y > 1.15
            or Particle.Age >= Particle.MaxLife
        then
            ResetParticle(Target, Particle, false)
        end
    end
end
