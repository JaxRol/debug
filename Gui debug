local function Round(Value, Step, Minimum, Maximum)
    Step = tonumber(Step) or 1
    Minimum = tonumber(Minimum) or 0
    Maximum = tonumber(Maximum)
    Value = tonumber(Value) or Minimum

    if Step <= 0 then
        Step = 1
    end

    if Maximum then
        Value = math.clamp(Value, Minimum, Maximum)
    end

    local StepCount = math.floor(((Value - Minimum) / Step) + 0.5)
    local Rounded = Minimum + (StepCount * Step)

    if Maximum and Rounded > Maximum then
        Rounded = Minimum
            + math.floor((Maximum - Minimum) / Step) * Step
    end

    return tonumber(string.format("%.10f", Rounded))
end
local function GetPlayers(ExcludeLocalPlayer: boolean?)
    local PlayerList = Players:GetPlayers()
    if ExcludeLocalPlayer then
        local Idx = table.find(PlayerList, LocalPlayer)
        if Idx then
            table.remove(PlayerList, Idx)
        end
    end
    table.sort(PlayerList, function(Player1, Player2)
        return Player1.Name:lower() < Player2.Name:lower()
    end)
    return PlayerList
end
