    return math.floor(Target.MaxParticles * math.clamp(Target.Intensity, 0, 100) / 100 + 0.5)
end
local function RefreshTargetParticleCount(Target)
    if not Target.Layer then
        return
    end
    local DesiredCount = GetDesiredParticleCount(Target)
    while #Target.Particles < DesiredCount do
        CreateTargetParticle(Target, true)
    end
    while #Target.Particles > DesiredCount do
        local Particle = table.remove(Target.Particles)
