                Dropdown.ValueImages[key] = val
            end
            Dropdown:BuildDropdownList()
        end
        function Dropdown:SetDisabled(Disabled: boolean)
            local ShouldDisable = Disabled == true
            local ShouldTurnOff = ShouldDisable and not Dropdown.DisabledCallbackApplied
            local ShouldRestore = not ShouldDisable and Dropdown.DisabledCallbackApplied

            if ShouldTurnOff then
                if Info.Multi then
                    local RestoreValue = {}
                    for Value, Active in Dropdown.Value do
                        if Active then
                            RestoreValue[Value] = true
                        end
                    end
                    Dropdown.DisabledRestoreValue = RestoreValue
                else
                    Dropdown.DisabledRestoreValue = Dropdown.Value
                end
            end

            Dropdown.Disabled = ShouldDisable
            if ShouldTurnOff then
                Dropdown.DisabledCallbackApplied = true
                Dropdown:SetValue(nil, false, true)
            elseif ShouldRestore then
                local RestoreValue = Dropdown.DisabledRestoreValue
                Dropdown.DisabledCallbackApplied = false
                Dropdown.DisabledRestoreValue = nil
                Dropdown:SetValue(RestoreValue, nil, true)
            end

            if Dropdown.TooltipTable then
                Dropdown.TooltipTable.Disabled = Dropdown.Disabled
            end
            MenuTable:Close()
            DisplayButton.Active = not Dropdown.Disabled
