            for _, v in DialogContainer:GetChildren() do
                if not v:IsA("UIListLayout") and not v:IsA("UIPadding") then
                    HasElements = true
                    break
                end
            end
            DialogContainer.Visible = HasElements
            ButtonsHolder.Visible = HasButtons
            _Sep2.Visible = HasButtons
        end
