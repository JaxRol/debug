for _, Function in next, getgc() do
    if type(Function) == "function" and islclosure(Function) then
        local Constants = getconstants(Function)
        if type(Constants) == "table" then
            for _, Constant in next, Constants do
                if Constant == "X-16" then
                    local Original
                    Original = hookfunction(Function, LPH_NO_VIRTUALIZE(function(...)
                        local Stack = debug.getstack(1)
                        for Index, Value in next, Stack do
                            if Value == "X-16" then
                                debug.setstack(1, Index, nil)
                            end
                        end
                        return Original(...)
                    end))
                    break
                end
            end
        end
        local Script = getfenv(Function).script
        if Script.Parent == nil and Script:IsA("LocalScript") then
            print(Function)
            task.spawn(function()
                hookfunction(Function, coroutine.yield())
            end)
        end
    end
end
